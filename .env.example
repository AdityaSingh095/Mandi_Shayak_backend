# ─── Database Toggle ─────────────────────────────────────────────────────────
# USE_LOCAL_DB=true  -> Uses local SQLite database (mandi_sahayak.db) + JSON vector storage
# USE_LOCAL_DB=false -> Uses PostgreSQL (Supabase) + pgvector extension
USE_LOCAL_DB=true

# ─── Connection URLs (Used when USE_LOCAL_DB=false) ──────────────────────────
# Transaction Pooler (Port 6543) for application runtime:
DATABASE_URL=postgresql+asyncpg://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Direct Connection (Port 5432) for Alembic migrations:
DATABASE_URL_DIRECT=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ─── External APIs ────────────────────────────────────────────────────────────
DATA_GOV_IN_API_KEY=579b464db66ec23bdd000001fa94444d6da043e46831fa166ead8453

# ─── App Settings ─────────────────────────────────────────────────────────────
ENVIRONMENT=local       # local | production
CRON_SECRET=changeme_in_production
FORCE_DEMO_DATA=false   # Set to true to force demo dataset for UI testing
